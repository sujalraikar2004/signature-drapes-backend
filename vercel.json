{
  "version": 2,
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/jobs/process?secret=5f8c2d9a7e4b1c6f3a8d5e2b9c7f4d1a6e3b8c5f2d9a7e4b1c6f3a8d5e2b9c7f4d1a6e3b8c5f2d9a7e4b1c6f3a8d5e2b9c7f",
      "schedule": "*/2 * * * *"
    }
  ]
}